{
  "permissions": {
    "allow": [
      "Bash(pnpm qar:*)",
      "Bash(qar:*)",
      "Bash(gh:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "openstax.atlassian.net",
        "*.qa.safeinsights.org",
        "*.staging.safeinsights.org",
        "*.*.staging.safeinsights.org",
        "app.staging.safeinsights.org",
        "app.safeinsights.org",
        "api.github.com",
        "api.mail.tm"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "pnpm qar",
      "qar",
      "gh"
    ]
  }
}
