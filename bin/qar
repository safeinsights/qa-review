#!/usr/bin/env bash
# qar — thin dispatcher so a bare `qar …` works in dev AND the packaged app.
#
# There is no `qar` binary: it's a pnpm script (`"qar": "tsx bin/qar.ts"`), so a
# bare `qar …` would 127. The GUI puts this dir on PATH and exports QAR_NODE +
# QAR_BUNDLE (packaged) via withGuiPath(), so prefer those. In a dev checkout they
# are unset, so fall back to `pnpm qar`.
#
# The two are deliberately SEPARATE vars, not one "<node> --import tsx <bundle>"
# command string: the packaged app lives under "/Applications/SI QA Runner.app",
# and a packed string can only be word-split (shattering that path at the space —
# `/Applications/SI: No such file or directory`) or quoted whole (not a command).
# Each var below is one word, so quoting it is both correct and sufficient.
set -euo pipefail
if [ -n "${QAR_NODE:-}" ] && [ -n "${QAR_BUNDLE:-}" ]; then
  if [ ! -x "${QAR_NODE}" ] || [ ! -f "${QAR_BUNDLE}" ]; then
    echo "qar: packaged engine is missing files from the app bundle." >&2
    echo "  QAR_NODE=${QAR_NODE}" >&2
    echo "  QAR_BUNDLE=${QAR_BUNDLE}" >&2
    echo "Reinstall the app; do NOT expect \`pnpm qar\` to work here." >&2
    exit 127
  fi
  exec "${QAR_NODE}" --import tsx "${QAR_BUNDLE}" "$@"
fi
# QAR_REPO_DIR without QAR_NODE/QAR_BUNDLE has TWO very different causes, and the
# only thing that tells them apart is whether the repo dir is a real checkout:
#
#   1. A DEV CHECKOUT pinning the repo explicitly — `wails dev` (resourcesDir() is ""
#      by design there, so the GUI exports QAR_REPO_DIR alone), and scripts like
#      scripts/approve-access.sh that set QAR_REPO_DIR="$REPO" to target a clone.
#      `pnpm qar` is exactly right here.
#   2. A PACKAGED app whose Resources/engine/qar.bundle.mjs wasn't found. `pnpm qar`
#      cannot work there: node_modules is a symlink into the .app, so pnpm dead-ends
#      on a node-version or pinned-pnpm error that names nothing real.
#
# bin/qar.ts is the engine SOURCE — present in every checkout, and never shipped in
# the .app (Resources/engine/ holds only qar.bundle.mjs + node_modules). So its
# presence in QAR_REPO_DIR distinguishes case 1 from case 2.
if [ -n "${QAR_REPO_DIR:-}" ] && [ ! -f "${QAR_REPO_DIR}/bin/qar.ts" ]; then
  echo "qar: QAR_REPO_DIR is set but QAR_NODE/QAR_BUNDLE are not," >&2
  echo "and ${QAR_REPO_DIR} is not a dev checkout (no bin/qar.ts)." >&2
  echo "The app could not locate its bundled engine (Resources/engine/qar.bundle.mjs)." >&2
  echo "This is a broken packaged install — reinstall the app." >&2
  exit 127
fi
# pnpm picks its project from the CWD, but callers invoke this shim by absolute path
# from wherever they happen to be. `pnpm -C` pins it to the checkout we resolved
# above so the fallback always runs THAT repo's engine.
if command -v pnpm >/dev/null 2>&1; then
  if [ -n "${QAR_REPO_DIR:-}" ]; then
    exec pnpm -C "${QAR_REPO_DIR}" qar "$@"
  fi
  exec pnpm qar "$@"
fi
echo "qar: neither QAR_NODE/QAR_BUNDLE nor pnpm available" >&2
exit 127
