node_modules/
results/
gui/build/engine/
gui/build/stage/
gui/build/node-cache/
gui/build/*.dmg
gui/build/*.zip
.env
.env.local
config/settings.local.json
config/age-identity.txt
# Extracted private keys — `qar get-secret --name <ROLE>_RESULTS_PRIVATE_KEY_<ENV>`
# writes a real results-decryption PEM to wherever you redirect it. Unlike the .png
# case below, a blanket extension rule is safe here: no .pem is tracked, and this repo
# has no legitimate reason to commit one.
*.pem
*.log
.worktrees/
.DS_Store
# Scratch for the Claude sessions: screenshots, draft Jira comment bodies, PR
# review payloads. The skills all write here so session output lands in ONE known
# place instead of each session inventing its own dir.
.tmp/
# Older spellings sessions used before .tmp/ was the convention. Deliberately a
# directory glob, not a blanket *.png: docs/images/ and gui/build/appicon.png are
# tracked, and an extension rule would silently hide edits to them.
.qa-valid*/
